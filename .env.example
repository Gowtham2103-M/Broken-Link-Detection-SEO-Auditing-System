# Optional. Copy these into your shell/environment; nothing reads a .env file
# automatically. If unset, the original defaults (localhost / root / root /
# siteaudit_db) are used.
SITEAUDIT_DB_HOST=localhost
SITEAUDIT_DB_PORT=3306
SITEAUDIT_DB_USER=siteaudit
SITEAUDIT_DB_PASSWORD=change-me
SITEAUDIT_DB_NAME=siteaudit_db

# Comma-separated list of browser origins allowed to call the API.
SITEAUDIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (frontend/.env): API location if not http://127.0.0.1:8000/api
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
